# DXP AI Gateway — provisioning worker
# Copy to .env and fill in:
#   cp .env.example .env
#
# The worker reads ONLY this file (lp/worker/.env). It shares no .env with the
# backend, which reads lp/backend/.env, so the shared values must be kept in step
# with it:
#
#   * EXTERNAL_PASSWORD_ENCRYPTION_KEY must be BYTE-IDENTICAL to the backend's.
#     It is not a fresh key: copy the existing value. A different key cannot
#     decrypt the site passwords the backend encrypted, and nothing fails at
#     compile time.
#   * DATABASE_URL must resolve to the SAME database as the backend's, otherwise
#     the worker polls an empty queue while the backend enqueues rows elsewhere.
#   * TPAI_* / APAI_* must point at the same platforms.

# Database. Same value as the backend's. Session mode / direct connection, never
# a transaction-mode pooler: the worker issues prepared statements.
DATABASE_URL=postgres://dxp:dxp@localhost:5432/dxp_ai_gateway?sslmode=disable

# New API external user provisioning (required)
TPAI_BASE_URL=https://tpai.example.com
TPAI_ADMIN_TOKEN=
APAI_BASE_URL=https://apai.example.com
APAI_ADMIN_TOKEN=

# Copy the backend's existing key — do not generate a new one.
EXTERNAL_PASSWORD_ENCRYPTION_KEY=

# Logging: stdout is JSON. debug | info (default) | warn | error
# debug also logs the per-poll heartbeat ("no accounts due"), which is how a
# healthy idle worker is told apart from a stuck one.
LOG_LEVEL=info

# Sentry (optional). Without SENTRY_DSN the SDK stays disabled, so local runs
# make no network calls. SENTRY_RELEASE is derived from the git/Vercel sha when
# left unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Fraction of transactions traced, 0.0-1.0. Tracing consumes quota.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Access service token. Must match the backend's values — the worker
# calls the same Zero Trust protected TPAI/APAI origins. Set both or neither.
CF_CLIENT_ID=
CF_CLIENT_SECRET=
