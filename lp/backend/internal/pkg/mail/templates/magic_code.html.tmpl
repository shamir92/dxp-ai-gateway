<!DOCTYPE html>
<html>
  <body style="font-family: system-ui, sans-serif; background: #f7f4ee; margin: 0; padding: 32px;">
    <div style="max-width: 480px; margin: 0 auto; background: #fff; border-radius: 16px; padding: 32px; border: 1px solid #e8e0d4;">
      <p style="font-size: 14px; color: #666; margin: 0 0 16px;">{{.ProductName}}</p>
      <h1 style="font-size: 20px; margin: 0 0 12px; color: #111;">Your {{.ActionLabel}} code</h1>
      <p style="font-size: 14px; color: #444; line-height: 1.6; margin: 0 0 20px;">
        Use this code to continue. It expires in {{.ExpiresInMinutes}} minutes and can be used once.
      </p>
      <p style="font-size: 32px; letter-spacing: 0.35em; font-weight: 700; text-align: center; background: #f7f4ee; padding: 18px; border-radius: 12px; margin: 0 0 20px;">
        {{.Code}}
      </p>
      <p style="font-size: 12px; color: #888; line-height: 1.6; margin: 0;">
        If you did not request this, you can ignore this email.<br/>
        {{.ProductName}} · {{.SupportEmail}}
      </p>
    </div>
  </body>
</html>
