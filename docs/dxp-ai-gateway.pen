                            {
                              "type": "text",
                              "id": "BTLSF",
                              "name": "We may also disclose information if requ",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 63.38,
                              "content": "We may also disclose information if required by law, to enforce our terms, or to protect the rights, property, or safety of our users or others. If we are involved in a merger, acquisition, or asset sale, personal information may be transferred, and we will notify you of any change in control or use of your information as required by law.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
