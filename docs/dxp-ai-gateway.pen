                              "content": "from openai import OpenAI\n\nclient = OpenAI(\n  base_url=\"...\",\n  api_key=\"$DXP_API_KEY\"\n)\n\nresponse = client.chat.completions.create(\n  model=\"mimo-v2.6-pro\",\n  messages=[{\"role\": \"user\", \"content\": \"Plan our launch\"}],\n  stream=True\n)\n\nfor chunk in response:\n  print(chunk.choices[0].delta.content)",
