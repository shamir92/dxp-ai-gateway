                                  "type": "text",
                                  "id": "Antz3",
                                  "name": "Taxes. Prices may exclude applicable tax",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Taxes. Prices may exclude applicable taxes (such as VAT or GST). Final totals are calculated at checkout. You are responsible for taxes that are your obligation under applicable law.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
