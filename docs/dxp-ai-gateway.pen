                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "i3IHGl",
                          "name": "13. Third-party links and services",
                          "context": "h2",
                          "fill": "#151515",
                          "content": "13. Third-party links and services",
                          "lineHeight": 1.5,
                          "fontFamily": "Roboto Slab",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "CMemc",
                          "name": "The Service relies on third-party provid",
                          "context": "p",
                          "fill": "#6d6962",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 63.38,
                          "content": "The Service relies on third-party providers (including model providers, payment, hosting, and messaging tools) and may link to third-party sites. Their handling of your information is governed by their own privacy policies, and we encourage you to review them.",
                          "lineHeight": 1.63,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
