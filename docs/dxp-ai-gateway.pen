                            {
                              "type": "text",
                              "id": "NJuyU",
                              "name": "We use your browser’s local storage to k",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "We use your browser’s local storage to keep you signed in (your authentication session). This is strictly necessary for the Service to function.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "j1slB",
                              "name": "We avoid analytics and advertising cooki",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 63.38,
                              "content": "We avoid analytics and advertising cookies where possible. If we introduce non-essential cookies or similar technologies, we will update this policy first and ask for your consent before they are placed on your device, where required. Rejecting optional cookies will not prevent you from using the site.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "qN4I3",
                              "name": "Some third-party resources we load (such",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "Some third-party resources we load (such as fonts or icon assets) may be served by a CDN that receives your IP address as part of delivering those files.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
