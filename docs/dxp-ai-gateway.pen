                      "gap": 16,
                      "padding": [
                        41,
                        0,
                        40,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "jrSbX",
                          "name": "12. Children’s privacy",
                          "context": "h2",
                          "fill": "#151515",
                          "content": "12. Children’s privacy",
                          "lineHeight": 1.5,
                          "fontFamily": "Roboto Slab",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "H3pOcO",
                          "name": "The Service is not directed to children,",
                          "context": "p",
                          "fill": "#6d6962",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 63.38,
                          "content": "The Service is not directed to children, and we do not knowingly collect personal information from anyone under the age of 16 (or the minimum age required in your jurisdiction). If you believe a child has provided us with personal information, contact hello@fromdxp.com and we will delete it.",
                          "lineHeight": 1.63,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "zgKqZ",
                      "name": "section",
                      "context": "section",
