                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "OWzAu",
                              "name": "Nothing in these Terms limits liability ",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
