                              "children": [
                                {
                                  "type": "text",
                                  "id": "xto0q",
                                  "name": "Account & identity. Email address and, i",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Account & identity. Email address and, if you sign in with a third-party identity provider, basic profile information (such as your name and email) used to create and authenticate your account.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "Dc27J",
                                  "name": "Billing & profile. Account type (individ",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Billing & profile. Account type (individual or business), full name, company and contact name, phone number, postal address, and tax identification number (optional).",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "V97TaN",
                                  "name": "Payments. Payments are processed by our ",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Payments. Payments are processed by our payment provider. We do not collect or store full payment card numbers. We receive limited transaction details such as order ID, product, amount, and status.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "Q0CsiM",
                                  "name": "Credit & usage records. Prepaid credit b",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "content": "Credit & usage records. Prepaid credit balance and a history of top-ups and metered usage events (see Section 3).",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "sHbVQ",
                                  "name": "Technical & log data. When you access th",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Technical & log data. When you access the Service, standard technical information such as IP address, browser and device type, and timestamps, used to serve and secure the Service.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "sqLzp",
                                  "name": "Communications. If you email us at hello",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Communications. If you email us at hello@fromdxp.com or message us on WhatsApp, we receive the contact details and content you choose to send.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "ZTDWi",
                              "name": "We do not intentionally collect specific",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "We do not intentionally collect specific (sensitive) personal data under the UU PDP (such as health, biometric, genetic, or children’s data). Please do not send such data through the API or by email.",
