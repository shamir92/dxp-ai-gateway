                              "children": [
                                {
                                  "type": "text",
                                  "id": "ipzv9",
                                  "name": "Purchasing credits. You may purchase cre",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "content": "Purchasing credits. You may purchase credit packs or subscribe to a plan at the prices shown in the Service.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "j0c9r",
                                  "name": "Payment. Payments are processed by our p",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Payment. Payments are processed by our payment providers. By purchasing, you agree to their applicable terms and authorize them to charge your selected payment method. We do not store your full payment card details.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
