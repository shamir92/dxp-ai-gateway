                            {
                              "type": "text",
                              "id": "R6snh",
                              "name": "To use the Service you must be at least ",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "To use the Service you must be at least 16 years old (or the minimum age required in your jurisdiction) and able to enter into a binding contract. The Service is not directed to children below that age.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
