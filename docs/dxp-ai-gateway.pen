                                  "type": "text",
                                  "id": "DFCUK",
                                  "name": "Consumption. Credits are consumed when y",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Consumption. Credits are consumed when you use metered features (including model token usage). Once consumed, credits cannot be restored.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "xvRgY",
                                  "name": "Refunds. Except where required by law, p",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Refunds. Except where required by law, purchased credits are non-refundable and have no cash value. Unused credits may be forfeited if your account is terminated for a breach of these Terms.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "if5FZ",
                                  "name": "Pricing changes. We may change prices, p",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 63.38,
                                  "content": "Pricing changes. We may change prices, pack sizes, or consumption rates. Changes apply to future purchases and consumption; credits already purchased remain valid at the rate in effect when consumed, subject to any expiration we communicate in advance.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
