                      "padding": [
                        41,
                        0,
                        40,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "I3KgRJ",
                          "name": "8. International data transfers",
                          "context": "h2",
                          "fill": "#151515",
                          "content": "8. International data transfers",
                          "lineHeight": 1.5,
                          "fontFamily": "Roboto Slab",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "NzKJV",
                          "name": "Because we and our providers may operate",
                          "context": "p",
                          "fill": "#6d6962",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 84.5,
                          "content": "Because we and our providers may operate globally, your information may be processed in countries other than the one in which you live, including countries that may not provide the same level of data protection. Where required, we rely on appropriate safeguards (such as standard contractual clauses or other lawful transfer mechanisms under the UU PDP and GDPR).",
                          "lineHeight": 1.63,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "TzzxZ",
                      "name": "section",
                      "context": "section",
                      "metadata": {
                        "type": "dom-import",
                        "sourceUrl": "http://localhost:3000/privacy",
                        "tag": "section",
                        "htmlId": "retention"
                      },
                      "width": "fill_container",
                      "height": 325.88,
                      "stroke": "#ded7cd",
                      "strokeWidth": {
                        "top": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "gap": 16,
                      "padding": [
                        41,
                        0,
                        40,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "wMhQR",
                          "name": "9. Data retention",
                          "context": "h2",
                          "fill": "#151515",
                          "content": "9. Data retention",
                          "lineHeight": 1.5,
                          "fontFamily": "Roboto Slab",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "frame",
                          "id": "KK8Ys",
                          "name": "div",
                          "context": "div",
                          "width": "fill_container",
                          "height": 195.88,
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "V3HqFa",
                              "name": "Request/response content: not stored aft",
                              "context": "p",
                              "fill": "#6d6962",
                              "content": "Request/response content: not stored after the request completes (see Section 2).",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "r7SRsJ",
                              "name": "Usage and billing logs: kept for as long",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "Usage and billing logs: kept for as long as needed for billing, accounting, dispute resolution, and legal compliance (typically the current billing period plus a reasonable statutory window).",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "sLtx7",
                              "name": "Account and profile data: kept for as lo",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "Account and profile data: kept for as long as your account is active. Transaction, invoice, and tax records are retained for the period required by applicable accounting and tax laws.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "dAwG3",
                              "name": "When information is no longer needed, we",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "When information is no longer needed, we delete or irreversibly anonymize it. You may request deletion of your account at any time (see Section 10).",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "OsRe9",
                      "name": "section",
                      "context": "section",
                      "metadata": {
                        "type": "dom-import",
                        "sourceUrl": "http://localhost:3000/privacy",
                        "tag": "section",
                        "htmlId": "security"
                      },
                      "width": "fill_container",
                      "height": 251.63,
                      "stroke": "#ded7cd",
                      "strokeWidth": {
                        "top": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "gap": 16,
                      "padding": [
                        41,
                        0,
                        40,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "tnMd0",
                          "name": "10. Security",
                          "context": "h2",
                          "fill": "#151515",
                          "content": "10. Security",
                          "lineHeight": 1.5,
                          "fontFamily": "Roboto Slab",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "frame",
                          "id": "drcSn",
                          "name": "div",
                          "context": "div",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 15.99,
                          "children": [
                            {
                              "type": "text",
                              "id": "qEH8k",
                              "name": "We protect your data with measures inclu",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 63.38,
                              "content": "We protect your data with measures including encryption in transit (HTTPS), access controls limiting who can read service data, and tightly scoped access to payment and service secrets. No method of transmission or storage is completely secure, but we work to protect your information and to address vulnerabilities promptly.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "pniWF",
                              "name": "If a personal data breach occurs that af",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 42.25,
                              "content": "If a personal data breach occurs that affects you, we will notify you and the relevant authority as required by the UU PDP (no later than 3 × 24 hours where applicable) and by other laws where they apply.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "x7h4BF",
                      "name": "section",
                      "context": "section",
                      "metadata": {
                        "type": "dom-import",
                        "sourceUrl": "http://localhost:3000/privacy",
                        "tag": "section",
                        "htmlId": "rights"
                      },
                      "width": "fill_container",
                      "height": 452.63,
                      "stroke": "#ded7cd",
                      "strokeWidth": {
                        "top": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "gap": 16,
                      "padding": [
                        41,
                        0,
                        40,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "ty3lY",
                          "name": "11. Your rights",
                          "context": "h2",
                          "fill": "#151515",
                          "content": "11. Your rights",
                          "lineHeight": 1.5,
                          "fontFamily": "Roboto Slab",
                          "fontSize": 22,
                          "fontWeight": "600"
                        },
                        {
                          "type": "frame",
                          "id": "hWHQl",
                          "name": "div",
                          "context": "div",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "VxsfU",
                              "name": "Depending on where you live, you have ri",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 63.38,
                              "content": "Depending on where you live, you have rights over your personal information. Subject to applicable law, these generally include the right to access, correct, delete, or export your data; to object to or restrict certain processing; and to withdraw consent.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "F0mxh",
                              "name": "ul",
                              "context": "ul",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 8,
                              "padding": [
                                0,
                                0,
                                0,
                                20
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "W7aXit",
                                  "name": "Indonesia (UU PDP, Law No. 27 of 2022). ",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "Indonesia (UU PDP, Law No. 27 of 2022). You have the right to be informed, access, correct, erase, and obtain your personal data; to withdraw consent; to object to certain processing; and to seek redress for misuse of your data.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "dRAxz",
                                  "name": "EEA & UK (GDPR). In addition to the righ",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "EEA & UK (GDPR). In addition to the rights above, you may lodge a complaint with your local data protection supervisory authority.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "IjXKO",
                                  "name": "California (CCPA/CPRA). You have the rig",
                                  "context": "li",
                                  "fill": "#6d6962",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 63.38,
                                  "content": "California (CCPA/CPRA). You have the right to know what personal information we collect, to delete it, to correct it, and to be free from discrimination for exercising your rights. We do not sell or share your personal information as those terms are defined under California law.",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "dlJVd",
                              "name": "To exercise any of these rights, email h",
                              "context": "p",
                              "fill": "#6d6962",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 63.38,
                              "content": "To exercise any of these rights, email hello@fromdxp.com (subject: “Data subject request”). We will respond within the timeframe required by applicable law and may need to verify your identity first. Many profile fields can be updated in account settings after you sign in.",
                              "lineHeight": 1.63,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cT3o8",
                      "name": "section",
                      "context": "section",
                      "metadata": {
                        "type": "dom-import",
